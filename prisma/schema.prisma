generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProviderStatus {
  NOT_APPLIED
  PHASE1_PENDING
  PHASE1_APPROVED
  PHASE2_PENDING
  PHASE2_APPROVED
  // No PHASE3_PENDING: Phase 3 is salon setup, which activates the provider on
  // submission rather than queueing for admin review.
  ACTIVE
  REJECTED
}

// ------------------- USERS -------------------
model User {
  id              String              @id @default(uuid())
  clerkId         String              @unique
  email           String              @unique
  name            String?
  isAdmin         Boolean             @default(false)
  providerStatus      ProviderStatus  @default(NOT_APPLIED)
  pushToken       String?   // legacy single token; per-device tokens live in PushToken
  pushTokens      PushToken[]

  bookings        Booking[]
  saloons         Saloon[]
  reviews         SaloonReview[]
  application     ProviderApplication?
  payouts         Payout[]

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("users")
}

// ------------------- SALOON -------------------
model Saloon {
  id             String         @id @default(uuid())
  name           String
  userId         String
  description    String?
  shortIntro     String?
  images         SaloonImage[]
  rating         Float          @default(0.0)
  address        String?
  
  // Location coordinates for map display
  latitude       Float?
  longitude      Float?

  user           User           @relation(fields: [userId], references: [id])
  saloonServices SaloonService[]
  bookings       Booking[]
  reviews        SaloonReview[]
  categories     Category[]     // Categories can be tied to saloons or global
  timeSlots      SaloonTimeSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saloons")
  @@index([userId])
}

// ------------------- IMAGES -------------------
model SaloonImage {
  id         String   @id @default(uuid())
  saloonId   String
  saloon     Saloon   @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  url        String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("saloon_images")
  @@index([saloonId])
}

// ------------------- CATEGORY -------------------
model Category {
  id          String    @id @default(uuid())
  saloonId    String?   // Optional for admin-created global categories
  saloon      Saloon?   @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  name        String
  isGlobal    Boolean   @default(false)  // True for admin-created global categories
  popular     Boolean   @default(false)
  
  services    Service[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([saloonId, name]) // Unique per saloon (null saloonId allowed for global categories)
  @@map("categories")
}

// ------------------- SALOON ↔ SERVICE -------------------
model SaloonService {
  saloonId        String
  saloon          Saloon   @relation(fields: [saloonId], references: [id])
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])

  price           Float
  durationMinutes Int
  isAvailable     Boolean  @default(true)

  // Available days (0 = Sunday, 1 = Monday, ..., 6 = Saturday)
  availableDays   Int[]    @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@id([saloonId, serviceId])
  @@map("saloon_services")
}

// ------------------- SERVICE -------------------
model Service {
  id              String          @id @default(uuid())
  name            String
  description     String?
  workTypes       ServiceWorkType[] @default([])

  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])

  parentServiceId String?
  parentService   Service?        @relation("ServiceHierarchy", fields: [parentServiceId], references: [id], onDelete: Cascade)
  subServices     Service[]       @relation("ServiceHierarchy")

  saloonServices  SaloonService[]
  bookings        Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

enum ServiceWorkType {
  UUDET
  POISTO
  HUOLTO
  EI_LISAKKEITA
  LYHYET
  KESKIPITKAT
  PITKAT
}

// ------------------- BOOKING -------------------
model Booking {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])

  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id])

  saloonId     String
  saloon       Saloon   @relation(fields: [saloonId], references: [id])

  bookingTime  DateTime
  status       String   @default("confirmed") // confirmed, completed, cancelled, no_show
  paymentMethod String  @default("pay_at_venue") // pay_at_venue, online (for future use)
  // Stripe PaymentIntent that paid for this booking. Null for pay_at_venue and
  // for rows predating this column. PATCH /api/checkout confirms a booking only
  // when the caller presents the PaymentIntent recorded here.
  paymentIntentId String?

  customerName  String?
  customerPhone String?
  customerEmail String?
  notes         String?
  totalAmount   Float?

  // Set once this booking's earnings are included in a provider payout, so a
  // booking can never be paid out twice. Null = not paid out yet.
  payoutId      String?
  payout        Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
  @@index([payoutId])
  @@index([saloonId])
  @@index([status])
  @@index([bookingTime])
  @@index([paymentMethod])
}

// ------------------- SALOON REVIEWS -------------------
model SaloonReview {
  id        String   @id @default(uuid())
  saloonId  String
  saloon    Saloon   @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      // 1..5
  comment   String?
  
  bookingId String?  // Optional for backward compatibility
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saloonId])
  @@index([userId])
  @@index([bookingId])
  @@map("saloon_reviews")
}

// ------------------- PROVIDER APPLICATION -------------------
model ProviderApplication {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])

  // Phase 1 — Expression of Interest
  firstName         String?
  lastName          String?
  phone             String?
  city              String?
  neighbourhood     String?
  address           String?
  serviceCategories String[]

  // Phase 2 — Contract & Verification
  legalName       String?
  dateOfBirth     String?
  finnishId       String?
  nationality     String?
  businessName    String?
  yTunnus         String?
  businessType    String?
  bankAccountName   String?
  iban              String?
  qualificationDocs String[]
  documentUrls      String[]
  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime?
  stripeConnected Boolean   @default(false)

  // Admin fields
  adminNotes     String?
  rejectedReason String?
  currentPhase   Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("provider_applications")
}

// ------------------- SALOON TIME SLOTS -------------------
model SaloonTimeSlot {
  id        String   @id @default(uuid())
  saloonId  String
  saloon    Saloon   @relation(fields: [saloonId], references: [id], onDelete: Cascade)
  
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String   // Format: "HH:MM" (e.g., "09:00")
  endTime   String   // Format: "HH:MM" (e.g., "18:00")
  isOpen    Boolean  @default(true)
  
  // Slot configuration
  slotDurationMinutes Int @default(30) // Duration of each slot
  breakTimeMinutes    Int @default(15) // Break time between appointments
  maxBookingsPerSlot  Int @default(1)  // Maximum bookings per time slot
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([saloonId, dayOfWeek])
  @@map("saloon_time_slots")
}

// ------------------- PAYOUTS -------------------
// One transfer of a provider's earnings to their bank account. Created by the
// weekly payout run (or an admin) from eligible bookings; see lib/payouts.ts.
model Payout {
  id              String    @id @default(uuid())
  userId          String    // the provider being paid
  user            User      @relation(fields: [userId], references: [id])
  saloonId        String

  gross           Float     // bookings total before the platform fee
  fee             Float     // platform fee kept
  amount          Float     // what the provider receives (gross - fee)
  currency        String    @default("EUR")

  // scheduled → sent → arrived, or failed (bookings are released back to the balance)
  status          String    @default("scheduled")
  scheduledFor    DateTime
  sentAt          DateTime?
  arrivedAt       DateTime?
  failedAt        DateTime?
  failureReason   String?
  reference       String?   // bank / transfer reference

  // Where the money goes, captured when the payout is created so a later
  // bank-details change can't alter where an existing payout was sent.
  iban            String
  bankAccountName String?

  bookings        Booking[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("payouts")
  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
}

// One row per app install (device). A user can have several; registering the
// same token from another account moves it there.
model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

// Expo push tickets awaiting their receipt. A daily cron fetches the receipts
// (Expo keeps them for 24 h) and removes tokens reported as DeviceNotRegistered.
model PushTicket {
  id        String   @id // Expo ticket id
  token     String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("push_tickets")
}
